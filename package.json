{
  "name": "calo-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-loader=./scripts/lib/path-alias-loader.mjs --test \"components/canvas-3d/*.test.ts\" \"components/plattegrond/*.test.ts\" \"lib/library/*.test.ts\" \"components/canvas-3d/mobile/*.test.ts\" \"lib/activities/*.test.ts\" \"lib/guest/*.test.ts\" \"lib/plattegrond/*.test.ts\" \"lib/landing/*.test.ts\" \"lib/beheer/*.test.ts\" \"lib/students/*.test.ts\" \"lib/subscription/*.test.ts\" \"lib/mobile/*.test.ts\"",
    "test:rls": "bash scripts/test-admin-rls.sh",
    "test:e2e": "playwright test",
    "perf:mobile": "node e2e/perf-mobile.mjs",
    "library:csv": "node --experimental-strip-types --experimental-loader=./scripts/lib/path-alias-loader.mjs --env-file-if-exists=.env.local scripts/library-taxonomy-csv.mts",
    "migrate:categories": "node --experimental-strip-types --experimental-loader=./scripts/lib/path-alias-loader.mjs --env-file-if-exists=.env.local scripts/migrate-categories.mts",
    "audit:collision": "node --experimental-strip-types --experimental-loader=./scripts/lib/path-alias-loader.mjs scripts/audit-collision.mts",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "migrate:activiteiten": "node --env-file=.env.local scripts/migrate-activiteiten.mjs",
    "validate:plattegrond": "node --experimental-strip-types --experimental-loader=./scripts/lib/path-alias-loader.mjs --env-file-if-exists=.env.local scripts/import-plattegrond.mts --validate-only",
    "import:plattegrond": "node --experimental-strip-types --experimental-loader=./scripts/lib/path-alias-loader.mjs --env-file-if-exists=.env.local scripts/import-plattegrond.mts",
    "process:students": "node --experimental-strip-types scripts/process-students.mts",
    "sync:environments": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/sync-environments.mts",
    "upload:students": "node --experimental-strip-types --env-file=.env.local scripts/upload-students.mts",
    "import:materials": "node --experimental-strip-types --experimental-loader=./scripts/lib/path-alias-loader.mjs --env-file=.env.local scripts/import-materials.mts",
    "eval:import": "node --experimental-strip-types --experimental-loader=./scripts/lib/path-alias-loader.mjs --env-file=.env.local scripts/eval-import.mjs",
    "mobile:icons": "node scripts/generate-app-icon.mjs",
    "app:build": "node scripts/app-build.mjs",
    "app:sync": "npm run app:build && cap sync",
    "app:ios": "npm run app:sync && cap open ios",
    "app:android": "npm run app:sync && cap open android",
    "mobile:sync": "cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-pdf/renderer": "^4.6.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@revenuecat/purchases-capacitor": "^14.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.2",
    "next": "^16.3.5",
    "officeparser": "^7.8.0",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
