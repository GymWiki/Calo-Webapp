# Kopieer dit bestand naar keystore.properties (zonder .example) in dezelfde
# map en vul de echte waarden in — keystore.properties zelf staat in
# .gitignore en mag NOOIT gecommit worden (bevat een wachtwoord in platte
# tekst). Zie docs/mobile-app/README.md "Android keystore aanmaken" voor hoe
# je de .keystore/.jks zelf genereert met `keytool`.
storeFile=release.keystore
storePassword=VUL_HIER_HET_KEYSTORE_WACHTWOORD_IN
keyAlias=VUL_HIER_DE_KEY-ALIAS_IN
keyPassword=VUL_HIER_HET_KEY_WACHTWOORD_IN
